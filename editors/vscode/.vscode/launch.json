{
  "version": "0.2.0",
  "configurations": [{
    "name": "Run Extension",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
    "outFiles": ["${workspaceFolder}/out/**/*.js"],
    "preLaunchTask": "npm: compile",
    "env": {
      "LUX_LSP_PATH": "${workspaceFolder}/../../target/debug/lux-lsp"
    }
  }]
}
