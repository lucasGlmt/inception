{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lux",
  "scopeName": "source.lux",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#colors" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.lux", "match": "//.*$" }] },
    "keywords": { "patterns": [{ "name": "keyword.control.lux", "match": "\\b(scene|rig|contract|role|let|mut|wait|over|Group|import|on)\\b" }] },
    "types": { "patterns": [{ "name": "storage.type.lux", "match": "\\b(Bool|Int|Float|Duration|Intensity|Color|Angle|Frequency|Tempo)\\b" }] },
    "colors": { "patterns": [{ "name": "constant.language.color.lux", "match": "\\b(red|green|blue|white|black|true|false)\\b|#[0-9a-fA-F]{6}\\b" }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.lux", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:ms|s|%|deg|Hz|bpm)?\\b" }] }
  }
}
